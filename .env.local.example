# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-...

# Twilio (OTP SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=...

# Wave Business (Paiement CI)
WAVE_API_KEY=...
WAVE_SECRET_KEY=...

# Cloudinary (Photos KYC / Chantier)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Jèko Checkout (server only). Webhook: /api/payment/jeko/webhook
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=

# Offres Urgent du parcours client (30 à 300 secondes, 1 à 10 destinataires)
NEXT_PUBLIC_DISPATCH_TIMEOUT_SECONDS=120
DISPATCH_RECIPIENT_LIMIT=3
